APP_NAME="山行档案"
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_SECURE_COOKIES=false
SHOW_DEMO_ACCOUNT=true

DATABASE_URL=postgresql://gohiking:gohiking@127.0.0.1:54329/gohiking
MEDIA_ROOT=./storage
UPLOAD_MAX_MB=20
UPLOADS_PER_HOUR=12

# Local, private multimodal scoring through Ollama
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
AI_TIMEOUT_MS=180000

# Or any OpenAI-compatible vision endpoint in production:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4.1-mini

CRON_SECRET=replace-with-a-long-random-string

# Docker Compose only (not read by the app)
POSTGRES_PASSWORD=replace-with-a-strong-db-password
APP_PORT=3000
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
