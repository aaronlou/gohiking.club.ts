# Production server env for docker-compose.prod.yml.
# Copy to /home/admin/gohiking.club/.env on the server and fill secrets.
APP_IMAGE=ghcr.io/aaronlou/gohiking-club.ts:latest
SEED_IMAGE=ghcr.io/aaronlou/gohiking-club.ts:seed-latest
APP_PORT=3000
APP_URL=https://gohiking.club
BETTER_AUTH_URL=https://gohiking.club

POSTGRES_DB=gohiking
POSTGRES_USER=gohiking
POSTGRES_PASSWORD=replace-with-strong-db-password
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
CRON_SECRET=replace-with-long-random-secret

AI_PROVIDER=openai
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=replace-with-deepseek-key
AI_TIMEOUT_MS=180000

REJECTED_RETENTION_HOURS=24
UPLOAD_MAX_MB=30
UPLOADS_PER_HOUR=12
