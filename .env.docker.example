# Copy to .env (or use your secret manager) before `docker compose up -d`.
APP_NAME=山行档案
APP_URL=https://gohiking.club
BETTER_AUTH_URL=https://gohiking.club
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_SECURE_COOKIES=true
POSTGRES_PASSWORD=replace-with-a-strong-db-password
APP_PORT=3000

# AI_PROVIDER=openai is recommended for production.
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4.1-mini

# Local Docker on macOS can still reach host Ollama:
AI_PROVIDER=ollama
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

CRON_SECRET=replace-with-a-long-random-string
UPLOAD_MAX_MB=20
UPLOADS_PER_HOUR=12
